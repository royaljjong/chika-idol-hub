[
  {
    "id": "kawaii-lab",
    "name": {
      "ja": "KAWAII LAB.",
      "ko": "카와이 랩 (KAWAII LAB.)",
      "en": "KAWAII LAB."
    },
    "shortName": {
      "ja": "カワラボ",
      "ko": "카와라보",
